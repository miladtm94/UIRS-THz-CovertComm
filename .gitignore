# ============================================================
# .gitignore for UIRS-THz-CovertComm MATLAB Simulation Project
# ============================================================

# ----- MATLAB generated files -----
*.asv           # Auto-saved MATLAB files
*.m~            # Backup MATLAB files
*.mex*          # Compiled MEX binaries
*.mlx           # MATLAB Live Scripts (binary)
*.slx           # Simulink models
*.slxc          # Compiled Simulink cache

# MATLAB desktop session files
*.mat.bak
matlab.prf

# ----- Simulation result files (large, auto-generated) -----
# These are generated by running the simulation scripts.
# To reproduce them, follow the instructions in README.md.
data/results/*.mat
data/raw/*.mat

# Exception: keep placeholder and README files
!data/results/.gitkeep
!data/raw/.gitkeep
!data/results/README_data.md

# ----- Auto-saved figures (regenerated by simulations) -----
figures/*.fig
figures/*.eps
figures/*.png
figures/*.pdf
figures/*.svg

# Exception: keep gitkeep
!figures/.gitkeep

# ----- CVX solver cache and logs -----
cvx_*.log
cvx_optval*
.cvxworkspace/

# ----- MOSEK license / temp files -----
*.lic
mosek.log
*.ptf

# ----- OS generated files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- IDE / Editor files -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Temporary / scratch files -----
tmp/
temp/
scratch/
*.tmp
*.log

# ----- User-specific MATLAB paths -----
pathdef.m

# ----- ZIP / compressed archives -----
*.zip
*.tar.gz
*.rar
